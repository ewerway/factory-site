class card {
    name;
    price;
    image;

    constructor(name, price, image) {
        this.image = image;
        this.name = name;
        this.price = price;
    }

    show() {
        // 1. Создаём обёртку карточки
        const card = document.createElement('div');
        card.className = 'card';

        // 2. Картинка
        const img = document.createElement('img');
        img.src = this.image;
        img.alt = this.name;

        // 3. Название
        const title = document.createElement('h3');
        title.textContent = this.name;

        // 4. Цена
        const price = document.createElement('p');
        price.className = 'price';
        price.textContent = `от ${this.price}`;

        // 5. Ссылка
        const more = document.createElement('a');
        more.href = '#';
        more.className = 'more';
        more.textContent = 'Подробнее';

        // 6. Собираем всё в карточку
        card.append(img, title, price, more);

        // 7. Возвращаем готовый элемент
        return card;
    }
}

let cards =
[
    new card("Синий трактор", "1.000.000 $", "Images/blue_tractor.png"),
    new card("Зеленый трактор", "2.000.000 $", "Images/1.jpg"),
    new card("Оранжевый трактор", "3.000.000 $", "Images/2.jpg"),
];

const container = document.getElementById('cards');

cards.forEach(card => {
    container.appendChild(card.show());
});